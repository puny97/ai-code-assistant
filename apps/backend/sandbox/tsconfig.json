{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "rootDir": "project",
    "types": ["node"],
    "resolveJsonModule": true
  },
  "include": ["project/**/*.ts"],
  "exclude": ["node_modules"]
}
